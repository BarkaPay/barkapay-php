{
    "name": "barkapay/barkapay-php",
    "description": "Official PHP SDK for the barkapay API — mobile-money collections, payouts and hosted payment links, one API across countries.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "barkapay",
        "payments",
        "payment links",
        "mobile money",
        "payouts",
        "mtn",
        "orange",
        "moov",
        "wave",
        "west africa",
        "api",
        "sdk"
    ],
    "homepage": "https://barkapay.com/developers",
    "support": {
        "issues": "https://github.com/BarkaPay/barkapay-php/issues",
        "source": "https://github.com/BarkaPay/barkapay-php",
        "security": "https://github.com/BarkaPay/barkapay-php/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.85",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "BarkaPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BarkaPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
